{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-default",
  "description": "Minimal permissions for the Nova desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
